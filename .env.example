# Application Environment
NODE_ENV=development

# Server Configuration
# Use 5000 by default. If the port is busy in development, the server can try PORT+1.
PORT=5000
PORT_FALLBACK=true
# Optional local upload root. Defaults to ./uploads.
# On Render, point this at a Persistent Disk mount path, for example /var/data/uploads.
UPLOAD_ROOT=

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>
# MONGO_URI is also supported for local setups that already use that name.

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Required for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Login / Signup
# Use the same OAuth Web Client ID as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# CORS Origins (comma-separated list)
# Include local dev URLs and every production frontend domain that calls this API.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000,https://www.aksharestate.in,https://aksharestate.in,https://akshar-real-estate.vercel.app

# Public frontend origin used for property links in backend-generated emails.
SITE_ORIGIN=https://www.aksharestate.in

# Gmail SMTP for property enquiry email notifications.
# Use a Google App Password. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aksharestate2006@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Akshar Estate : The Property Hub
ENQUIRY_FALLBACK_EMAIL=aksharestate2006@gmail.com
